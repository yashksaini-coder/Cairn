# ---------------------------------------------------------------- cairn-api
# Required. Copy from `anchor keys sync` output / target/deploy/cairn-keypair.json.
CAIRN_PROGRAM_ID=

SOLANA_RPC_URL=https://api.devnet.solana.com
BIND=0.0.0.0:8080
DATABASE_URL=sqlite://cairn.db?mode=rwc
PUBLIC_BASE_URL=http://localhost:8080

# Optional. Unset means receipts are issued with empty transcripts (§12),
# which is a valid receipt -- the pipeline still works end to end.
ELEVENLABS_API_KEY=

# Blob storage. With R2_BUCKET unset, audio is written to BLOB_DIR and served
# from /v1/blobs/. Setting R2_BUCKET requires building with --features s3.
BLOB_DIR=./blobs
# R2_BUCKET=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_BASE=https://<your-public-r2-domain>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Tunables. Defaults match §12's caps.
INDEX_INTERVAL_SECS=3
MAX_AUDIO_BYTES=10485760
MIN_AUDIO_BYTES=4096
MAX_AUDIO_MS=120000
MIN_AUDIO_MS=3000
CHALLENGE_TTL_SECS=120

# ---------------------------------------------------------------- cairn-cli
CAIRN_API_URL=http://localhost:8080
